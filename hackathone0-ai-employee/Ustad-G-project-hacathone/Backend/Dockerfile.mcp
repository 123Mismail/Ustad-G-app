# Use a specific slim image
FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install build dependencies if needed (optional, kept slim)
# RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the necessary code for the MCP server
COPY mcp_server/ ./mcp_server/
COPY app/config.py ./app/config.py

# Cloud Run injects PORT, but we'll use MCP_PORT as our internal variable
EXPOSE 8080

# Run using the module flag
CMD ["python", "-m", "mcp_server.server"]
