# ── LLM Gateway ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model names (OpenRouter model IDs)
PRIMARY_MODEL=google/gemini-pro-1.5
FAST_MODEL=google/gemini-flash-1.5
FALLBACK_MODEL=anthropic/claude-3.5-sonnet

# ── Google Services ──────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_SHEETS_CREDENTIALS=path/to/service_account.json
GOOGLE_SHEETS_BOOKING_ID=your_google_sheet_id_here

# ── MCP Server ───────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8001

# ── App Config ───────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
